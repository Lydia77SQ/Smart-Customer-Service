# SQLite 数据库文件（相对 backend/ 目录）
DATABASE_PATH=data/service_robot.db
# Markdown 原文件与持久化目录
UPLOAD_DIR=data/uploads
# 后端监听地址
HOST=127.0.0.1
# Agent/Tester 后端端口
PORT=8099
# 调试开关
DEBUG=false
# Session 签名与哈希盐（无默认值，必须替换为本地密钥）
SECRET_KEY=change-me
# CORS 白名单（Agent 5199 + 用户门禁 5175）
CORS_ORIGINS=["http://localhost:5199","http://127.0.0.1:5199","http://localhost:5175","http://127.0.0.1:5175"]
# 登录会话有效期（小时）
SESSION_EXPIRE_HOURS=72
# 账号最小长度
ACCOUNT_MIN_LENGTH=3
# 账号最大长度
ACCOUNT_MAX_LENGTH=64
# 密码最小长度
PASSWORD_MIN_LENGTH=6
# 密码最大长度
PASSWORD_MAX_LENGTH=128
# 工单标题截取长度
TICKET_TITLE_MAX_LENGTH=80
# 员工单条消息上限
EMPLOYEE_MESSAGE_MAX_LENGTH=4000
# 坐席单条消息上限
AGENT_MESSAGE_MAX_LENGTH=4000
# 工单列表默认页码
TICKET_LIST_PAGE_DEFAULT=1
# 工单列表每页条数
TICKET_LIST_PAGE_SIZE=20
# 工单列表每页上限
TICKET_LIST_PAGE_SIZE_MAX=100
# 知识列表默认页码
KNOWLEDGE_LIST_PAGE_DEFAULT=1
# 知识列表每页条数
KNOWLEDGE_LIST_PAGE_SIZE=50
# 单 Markdown 上限（20MB）
KNOWLEDGE_MAX_SIZE_BYTES=20971520
# 标准问答高置信直出阈值
QA_SIMILARITY_THRESHOLD=0.8
# 短期记忆轮数
SHORT_TERM_MEMORY_ROUNDS=3
# 向量检索与关键词检索各取 Top-K
SEARCH_TOP_K=10
# RRF 融合常数 k
RRF_K=60
# 重排后保留片段数
RERANK_TOP_N=5
# 知识切片字符数
CHUNK_SIZE=800
# 切片重叠字符数
CHUNK_OVERLAP=100
# 百炼统一 API Key（无默认值，完整联调需替换；缺省时仅能降级）
DASHSCOPE_API_KEY=your-dashscope-api-key
# 对话 API Base URL
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 对话模型名
LLM_MODEL=qwen-max
# 对话 HTTP 超时（秒）
LLM_TIMEOUT_SECONDS=60
# 意图识别温度
LLM_TEMPERATURE_INTENT=0.1
# 生成答复温度
LLM_TEMPERATURE_GENERATION=0.3
# 向量化 API URL
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
# 向量化模型名
EMBEDDING_MODEL=text-embedding-v3
# 向量化 HTTP 超时（秒）
EMBEDDING_TIMEOUT_SECONDS=30
# 向量维度
EMBEDDING_DIMENSIONS=1024
# 重排 API URL
RERANK_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 重排模型名
RERANK_MODEL=gte-rerank
# 重排 HTTP 超时（秒）
RERANK_TIMEOUT_SECONDS=30
# httpx 禁止继承环境变量
HTTP_CLIENT_TRUST_ENV=false
# 外部能力不可用时的答疑降级文案
DEGRADED_QA_MESSAGE=暂时无法自动答疑，请稍后再试，或转人工等待对接人。
# 建议失败文案
DEGRADED_SUGGESTION_MESSAGE=暂时无法生成建议。请手写回复，不要向员工发送自动消息。
# 转人工成功提示
TRANSFER_SUCCESS_MESSAGE=已提交，等待对接人
